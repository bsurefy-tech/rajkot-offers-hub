# Production settings that are not secret, committed so a build needs no dashboard variables.
# Next.js reads them at build time (pages are prerendered from the API) and OpenNext carries them
# into the worker. Secrets (API_FRONTEND_KEY) go in Cloudflare: npx wrangler secret put API_FRONTEND_KEY
# Locally, .env.local takes precedence over this file.
RAJKOT_API_URL=https://v2-api.rajkotoffershub.com

# The API's public media URL (Laravel's AWS_URL), so next/image accepts offer photos:
MEDIA_PUBLIC_URL=https://assets.bsurefy.com

# Points, rewards and scratch cards: turn on once the API platform has the `loyalty` feature on (see README).
LOYALTY_ENABLED=true

# Google Search Console ownership check: the content of its HTML meta tag (optional):
# GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools ownership check: the content of its msvalidate.01 meta tag (optional):
# BING_SITE_VERIFICATION=

# Business app store links for the "Submit an offer" page (optional):
# NEXT_PUBLIC_OWNER_APP_ANDROID_URL=
# NEXT_PUBLIC_OWNER_APP_IOS_URL=

# OpenPanel analytics (self-hosted). The client id is public by design; the browser only talks to this site's /api/op proxy.
OPENPANEL_ENABLED=true
OPENPANEL_API_URL=https://analytics.surefy.dev/api
OPENPANEL_CLIENT_ID=23b4a667-7364-49a8-97ab-319b32d007a2
