# The BSurefy API, on the Rajkot Offers host (it picks the platform from the host).
# Production: https://v2-api.rajkotoffershub.com · Local: http://api.rajkotoffers.test:8000/api
RAJKOT_API_URL=http://api.rajkotoffers.test:8000/api
# Only when calling the shared management host (api.bsurefy.com) instead of a platform host:
# RAJKOT_API_PLATFORM=rajkot-offers

# The API's WEB_FRONTEND_KEY (server-side only, never NEXT_PUBLIC_). With it the API sees each
# visitor's own IP for login limits and offer stats, instead of this server's for everyone.
# API_FRONTEND_KEY=

# Image host of the API's media (for next/image), e.g. https://media.bsurefy.com
# MEDIA_PUBLIC_URL=   (several hosts: comma-separated)

# Google Search Console ownership check: the content of its HTML meta tag (optional):
# GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools ownership check: the content of its msvalidate.01 meta tag (optional):
# BING_SITE_VERIFICATION=

# Business app store links for the "Submit an offer" page (optional; WhatsApp is shown without them)
# NEXT_PUBLIC_OWNER_APP_ANDROID_URL=
# NEXT_PUBLIC_OWNER_APP_IOS_URL=

# Points, rewards and scratch cards: true once the API platform has the `loyalty` feature on (and `referrals` for invites)
# LOYALTY_ENABLED=true

# Status and Zalak come from the API (a platform with the `statuses` / `reels` features off shows nothing).
# For development without them, true shows sample posts built from the offers:
# ZALAK_MOCK=true

# OpenPanel analytics (self-hosted). Off unless OPENPANEL_ENABLED=true, so local work sends nothing; to try it, point these
# at a staging project (not production). The browser talks to this site's /api/op proxy, which forwards to the API URL.
# OPENPANEL_ENABLED=true
# OPENPANEL_API_URL=https://analytics.example.com/api
# OPENPANEL_CLIENT_ID=
# Server-side events (API errors): the project's client secret. Server only; on the Worker: npx wrangler secret put OPENPANEL_CLIENT_SECRET
# OPENPANEL_CLIENT_SECRET=
