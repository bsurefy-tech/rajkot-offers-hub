{
  "name": "rajkot-offers-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:launch": "node scripts/launch-check.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@openpanel/nextjs": "1.5.1",
    "clsx": "2.1.1",
    "hls.js": "^1.7.3",
    "leaflet": "1.9.4",
    "lucide-react": "1.52.0",
    "next": "16.4.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.10",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "1.9.21",
    "@types/node": "^20",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "4.150.0"
  },
  "packageManager": "pnpm@12.4.1"
}
